---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Next Roll | A simple film logging app',
  description = 'Keep your cameras, rolls and film stock in one calm, useful place.',
} = Astro.props;
const path = Astro.url.pathname;
const pageUrl = new URL(path, Astro.site ?? Astro.url);
const imageUrl = new URL('/og-image.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Next Roll" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.toString()} />
    <meta property="og:image" content={imageUrl.toString()} />
    <meta property="og:image:width" content="750" />
    <meta property="og:image:height" content="750" />
    <meta property="og:image:alt" content="Next Roll logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href="/next-roll-mono.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Next Roll home">
          <img src="/next-roll-whole.svg" alt="Next Roll" />
        </a>
        <nav aria-label="Main navigation">
          <a class:list={{ active: path === '/' }} href="/">Home</a>
          <a class:list={{ active: path === '/support/' }} href="/support/">Support</a>
          <a class:list={{ active: path === '/privacy/' }} href="/privacy/">Privacy</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>A simple log for your cameras and rolls.</span>
        <span>© {new Date().getFullYear()} Next Roll</span>
      </footer>
    </div>
    <script>
      import posthog from 'posthog-js';

      const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY;
      const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com';

      if (apiKey) {
        posthog.init(apiKey, {
          api_host: apiHost,
          autocapture: false,
          capture_pageview: false,
          capture_pageleave: false,
          disable_session_recording: true,
          person_profiles: 'never',
          persistence: 'memory',
        });
        posthog.capture('website_page_view', { path: window.location.pathname });
      }
    </script>
  </body>
</html>
