---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Support | Next Roll">
  <section class="page">
    <h1>Need help?</h1>
    <p class="page-intro">Tell us what happened and what you expected. We will get back to you as soon as we can.</p>
    <div class="support-grid">
      <article class="support-card"><span class="eyebrow">01 / Email</span><h2>Talk to a human</h2><p>Questions, bugs or ideas for a better film log.</p><a href="mailto:support@nextroll.app">support@nextroll.app ↗</a></article>
      <article class="support-card"><span class="eyebrow">02 / Before you write</span><h2>Include the details</h2><p>Your device, app version and a short description are helpful.</p></article>
    </div>
  </section>
</SiteLayout>
